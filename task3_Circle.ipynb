      "source": [
        "class Circle:\n",
        "    def __init__(self, r , pi = 3.14):\n",
        "      self.r = r\n",
        "      self.pi = pi\n",
        "    def getArea(self):\n",
        "        return self.r * self.r * self.pi\n",
        "\n",
        "print(Circle(5, 3.14).getArea())"
      ],
